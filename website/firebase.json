{
  "hosting": {
    "site": "scraveit-in",
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          {"key": "X-Content-Type-Options", "value": "nosniff"},
          {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
          {"key": "X-Frame-Options", "value": "SAMEORIGIN"}
        ]
      },
      {
        "source": "**/*.@(html|xml|txt|json|webmanifest|js)",
        "headers": [{"key": "Cache-Control", "value": "public, max-age=300"}]
      },
      {
        "source": "**/*.@(css|svg)",
        "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
      },
      {
        "source": "/partner{,/,/index.html,/partner.js}",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      }
    ],
    "redirects": [
      {"source": "/index.html", "destination": "/", "type": 301},
      {"source": "/app", "destination": "https://play.google.com/store/apps/details?id=com.feastly.app", "type": 302},
      {"source": "/delivery/:code", "destination": "https://play.google.com/store/apps/details?id=com.feastly.rider&referrer=ref%3D:code", "type": 302},
      {"source": "/delivery", "destination": "https://play.google.com/store/apps/details?id=com.feastly.rider", "type": 302},
      {"source": "/restaurant", "destination": "https://play.google.com/store/apps/details?id=com.feastly.restaurant", "type": 302}
    ],
    "rewrites": [
      {"source": "/pay", "function": {"functionId": "cashfreeCheckout", "region": "asia-south1"}},
      {"source": "/shop/**", "destination": "/shop/index.html"}
    ]
  }
}
