rules_version = '2';

// Firestore rules matched against the ACTUAL schema `functions/src` reads and
// writes (see firestorePaths.ts and each service file) - not the earlier,
// more aspirational schema the migration plan first sketched. Two schema
// decisions from that original sketch never actually happened during the
// Cloud Functions conversion, and this file was drifting from reality until
// this pass fixed it:
//
//   - 'staff/{uid}' and 'restaurantMembers/{restaurantId}_{uid}' were meant
//     to collapse into one 'staffMembers' collection, but the real code kept
//     them separate (collapsing depends on the Phase 4 data migration having
//     run first - doing it in rules alone would make every membership check
//     here silently pass against an empty collection while the real server
//     code kept reading the two real ones).
//   - 'restaurants/{id}/menuItems/{itemId}' was meant to replace both menu
//     sources, but the real code kept the top-level 'menus/{restaurantId}'
//     document with an 'items' subcollection instead (same reasoning as
//     above - the embedded restaurant.menu field still has its own callers).
//
// Everything below matches what the server (and, from here, direct client
// reads under Phase 3) actually reads and writes today.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Reusable authorization helpers.
    // ---------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function isPrivileged() {
      return signedIn() &&
        (request.auth.token.savrivoRole == 'owner' || request.auth.token.savrivoRole == 'ops_admin');
    }

    function validDemographics(d) {
      return d.keys().hasOnly(['gender', 'birthDate', 'consent', 'edits', 'updatedAt'])
        && d.consent == true
        && d.gender in ['female', 'male', 'other', '']
        && (!('birthDate' in d) || d.birthDate == ''
          || (d.birthDate is string && d.birthDate.matches('^(19|20)[0-9]{2}-[01][0-9]-[0-3][0-9]$')
            && int(d.birthDate.split('-')[0]) <= request.time.year() - 18))
        && d.edits is int
        && d.updatedAt is int && d.updatedAt <= request.time.toMillis() + 600000;
    }

    function isOwnUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Mirrors authz.ts's membershipAllows(): an active membership grants
    // 'orders'/'handover' style access only via owner/manager role or the
    // named permission flag being explicitly true.
    function memberGrants(member, permission) {
      return member.active == true &&
        (member.role in ['restaurant_owner', 'restaurant_manager'] ||
         (member.permissions != null && member.permissions[permission] == true));
    }

    // restaurantMembers/{restaurantId}_{uid} - composite id, so this is a
    // point lookup, not a query. A record's own 'restaurantId' field is
    // optional here (domain/restaurantAccess.ts trusts the composite id's
    // own scoping when the field is absent); a legacy staff/{uid} record has
    // no such path scoping, so its 'restaurantId' field is required instead.
    function normalizedMemberGrants(restaurantId, permission) {
      let path = /databases/$(database)/documents/restaurantMembers/$(restaurantId + '_' + request.auth.uid);
      return exists(path) &&
        (!('restaurantId' in get(path).data) || get(path).data.restaurantId == restaurantId) &&
        memberGrants(get(path).data, permission);
    }

    function legacyStaffGrants(restaurantId, permission) {
      let path = /databases/$(database)/documents/staff/$(request.auth.uid);
      return exists(path) && get(path).data.restaurantId == restaurantId &&
        memberGrants(get(path).data, permission);
    }

    function isRestaurantStaff(restaurantId, permission) {
      return signedIn() && restaurantId != null &&
        (normalizedMemberGrants(restaurantId, permission) || legacyStaffGrants(restaurantId, permission));
    }

    function isRestaurantOwnerStaff(restaurantId) {
      return isRestaurantStaff(restaurantId, 'ownership') ||
        (signedIn() && restaurantId != null && (
          (exists(/databases/$(database)/documents/restaurantMembers/$(restaurantId + '_' + request.auth.uid)) &&
            get(/databases/$(database)/documents/restaurantMembers/$(restaurantId + '_' + request.auth.uid)).data.active == true &&
            get(/databases/$(database)/documents/restaurantMembers/$(restaurantId + '_' + request.auth.uid)).data.role == 'restaurant_owner') ||
          (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.restaurantId == restaurantId &&
            get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true &&
            get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'restaurant_owner')
        ));
    }

    function canManageRestaurant(restaurantId, permission) {
      return isPrivileged() || isRestaurantStaff(restaurantId, permission);
    }

    function riderDoc(riderId) {
      return get(/databases/$(database)/documents/riders/$(riderId));
    }

    function isApprovedRider() {
      return signedIn() && riderDoc(request.auth.uid).data.status == 'approved';
    }

    // ---------------------------------------------------------------
    // Catalog: restaurants + their menu items (public read, browse-only)
    // ---------------------------------------------------------------
    match /restaurants/{restaurantId} {
      allow read: if true; // Restaurant listings are public browsing, same as any food-delivery app's menu pages.
      // Bank details never go on the public listing (see restaurantPayoutProfiles below).
      allow create: if isPrivileged() && !('payoutProfile' in request.resource.data);
      allow delete: if isPrivileged();
      allow update: if (isPrivileged()
        || canManageRestaurant(restaurantId, 'profile')
        || canManageRestaurant(restaurantId, 'availability'))
        // Removing them (the one-time clean-up) is the only allowed change.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['payoutProfile'])
          || !('payoutProfile' in request.resource.data))
        // Restaurant, grocery store or dairy is set by Scraveit at approval,
        // and so is the commission rate the restaurant agreed to.
        && (isPrivileged() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['storeType', 'selfDelivery', 'deliveryTaxTreatment', 'commissionBps', 'commissionTermMonths', 'agreementVersion', 'agreementSignedAt', 'fssaiNumber', 'fssaiKind', 'fssaiExpiresOn',
          'compositeTreatmentApproved', 'compositeTreatmentEffectiveFrom', 'principalSupplyTaxCode', 'principalSupplyType',
          'principalSupplyGstRateBps']));
    }

    // A restaurant's bank account, IFSC, UPI, PAN and GSTIN: only its
    // bank-permitted staff and Scraveit admins can read or change them.
    match /restaurantPayoutProfiles/{restaurantId} {
      allow read, write: if canManageRestaurant(restaurantId, 'bank');
    }

    // menus/{restaurantId} is a document (not itself readable content - the
    // real items live in its 'items' subcollection); catalog.ts also falls
    // back to an embedded restaurant.menu array when this is empty, so this
    // stays public-read like the restaurant doc itself.
    match /menus/{restaurantId} {
      allow read: if true;
      allow write: if canManageRestaurant(restaurantId, 'menu');

      match /items/{itemId} {
        allow read: if true;
        allow write: if canManageRestaurant(restaurantId, 'menu');
      }
    }

    // Search-token inverted index. Each token is its own document in a
    // per-city subcollection (not a field on the city document) - a client's
    // type-ahead needs to range over the key space itself, which Firestore
    // only supports via document-id range queries, never over field names
    // inside one document. Same public-read reasoning as catalog itself.
    match /catalogSearchTokens/{cityKey}/tokens/{entry} {
      allow read: if true;
      allow write: if isPrivileged(); // Cloud Functions only in practice (Admin SDK bypasses rules).
    }

    // ---------------------------------------------------------------
    // Restaurant staff - two real sources, not a collapsed one (see the
    // header comment). A membership record's own uid is its document id
    // suffix, not a stored field, so ownership reads compare on the id.
    // ---------------------------------------------------------------
    match /restaurantMembers/{memberKey} {
      allow read: if isPrivileged() ||
        memberKey == resource.data.restaurantId + '_' + request.auth.uid ||
        isRestaurantOwnerStaff(resource.data.restaurantId);
      allow write: if isPrivileged() || isRestaurantOwnerStaff(resource.data.restaurantId);
    }

    match /staff/{uid} {
      allow read: if isPrivileged() || isOwnUser(uid) || isRestaurantOwnerStaff(resource.data.restaurantId);
      allow write: if isPrivileged() || isRestaurantOwnerStaff(resource.data.restaurantId);
    }

    match /restaurantStaffInvites/{inviteId} {
      allow read, write: if isPrivileged() || isRestaurantOwnerStaff(resource.data.restaurantId);
    }

    // Restaurant applications use the applicant's uid; grocery and dairy
    // applications use "<uid>_grocery" / "<uid>_dairy" with a matching storeType.
    match /restaurantApplications/{appId} {
      allow read: if isPrivileged() || (signedIn() &&
        appId in [request.auth.uid, request.auth.uid + '_grocery', request.auth.uid + '_dairy']);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && !request.resource.data.keys().hasAny(['terms', 'agreement', 'reviewedAt', 'reviewedBy', 'restaurantId', 'approvedAt'])
        && request.resource.data.get('status', 'submitted') in ['draft', 'submitted'] && (
        (appId == request.auth.uid && request.resource.data.get('storeType', 'restaurant') == 'restaurant')
        || (appId == request.auth.uid + '_grocery' && request.resource.data.storeType == 'grocery')
        || (appId == request.auth.uid + '_dairy' && request.resource.data.storeType == 'dairy'));
      // The applicant fills and edits their own application until it is
      // approved; the agreed terms, the signed agreement and the review are
      // written only by Scraveit (Admin app or Cloud Functions).
      allow update: if isPrivileged() || (signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && resource.data.get('status', 'submitted') in ['draft', 'submitted', 'changes_requested']
        && request.resource.data.get('status', 'draft') in ['draft', 'submitted']
        && resource.data.get('agreement', {}).get('status', '') != 'signed'
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'storeType', 'terms', 'agreement',
          'reviewedAt', 'reviewedBy', 'reviewMessage', 'restaurantId', 'approvedAt']));
      allow delete: if isPrivileged();
    }

    match /restaurantAgreements/{recordId} {
      allow read, write: if isPrivileged();
    }

    // ---------------------------------------------------------------
    // Customer profile
    // ---------------------------------------------------------------
    match /users/{uid} {
      allow read, write: if isPrivileged() || isOwnUser(uid);

      match /addresses/{addressId} {
        allow read, write: if isPrivileged() || isOwnUser(uid);
      }
    }

    // "About you": optional gender and date of birth for offers made for the
    // customer and for aggregate insights. Saved only with consent; deleting
    // it withdraws consent (DPDP Act, 2023). No one under 18 can be saved,
    // and a few edits at most, so it can't be flipped to farm group offers.
    match /customerDemographics/{uid} {
      allow read: if isPrivileged() || isOwnUser(uid);
      allow delete: if isPrivileged() || isOwnUser(uid);
      allow create: if isOwnUser(uid) && validDemographics(request.resource.data)
        && request.resource.data.edits == 0;
      allow update: if isPrivileged() || (isOwnUser(uid) && validDemographics(request.resource.data)
        && request.resource.data.edits == resource.data.edits + 1 && resource.data.edits < 4);
    }

    // One document per user holding a map of restaurantId -> true, not a
    // subcollection (deviceTokens.ts reads the whole map in one get()).
    match /userRestaurants/{uid} {
      allow read: if isPrivileged() || isOwnUser(uid);
      allow write: if isPrivileged();
    }

    // ---------------------------------------------------------------
    // Orders - single flat collection. restaurantOrders is a separate,
    // permanent privacy-scoped projection (customerPhone/address stripped),
    // not a query convenience over this collection - Firestore has no
    // field-level security, so restaurant staff read that one instead of
    // this one directly.
    // ---------------------------------------------------------------
    match /orders/{orderId} {
      allow read: if isPrivileged()
        || isOwnUser(resource.data.customerId)
        || (isApprovedRider() && resource.data.riderId == request.auth.uid)
        || canManageRestaurant(resource.data.restaurantId, 'orders')
        || canManageRestaurant(resource.data.restaurantId, 'handover')
        || canManageRestaurant(resource.data.restaurantId, 'tracking')
        // Friends in a squad order follow it on their own phones (read only).
        || (signedIn() && resource.data.get('squadMemberUids', []) is list
            && request.auth.uid in resource.data.get('squadMemberUids', []));

      // Orders are created only by the createOrder / createCodOrder callables
      // (Admin SDK), which price them on the server. A client-written order
      // could carry any price and would still reach the restaurant as a new
      // order, so clients cannot create one directly.
      allow create: if false;
      allow update, delete: if isPrivileged();
    }

    // Doc id is `${restaurantId}_${customerId}_${orderId}` (restaurantOrderProjectionRef).
    match /restaurantOrders/{projectionId} {
      allow read: if isPrivileged()
        || isOwnUser(resource.data.customerId)
        || (isApprovedRider() && resource.data.riderId == request.auth.uid)
        || canManageRestaurant(resource.data.restaurantId, 'orders')
        || canManageRestaurant(resource.data.restaurantId, 'handover')
        || canManageRestaurant(resource.data.restaurantId, 'tracking');
      allow write: if isPrivileged(); // Cloud Functions only (orderProjection.ts).
    }

    match /dispatchQueue/{orderId} {
      allow read: if isPrivileged() || isApprovedRider()
        || canManageRestaurant(resource.data.restaurantId, 'dispatch');
      allow write: if isPrivileged(); // Server-owned dispatch state machine.
    }

    // Doc id is `${riderId}_${orderId}` (dispatch.ts's riderOfferRef).
    match /riderOffers/{offerId} {
      allow read: if isPrivileged() || isOwnUser(resource.data.riderId);
      allow write: if isPrivileged(); // Cloud Functions only.
    }

    // Doc id is `${riderId}_${orderId}` (firestorePaths.ts's riderJobRef).
    match /riderJobs/{jobId} {
      allow read: if isPrivileged() || isOwnUser(resource.data.riderId)
        || canManageRestaurant(resource.data.restaurantId, 'tracking');
      // The one client-writable field in the RTDB version was the restaurant-arrival
      // marker; preserve that as the sole rider-writable case, everything else server-only.
      allow update: if isPrivileged() ||
        (isOwnUser(resource.data.riderId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase', 'arrivedRestaurantAt']) &&
         resource.data.phase == 'pickup' && request.resource.data.phase == 'at_restaurant');
      allow create, delete: if isPrivileged();
    }

    // Doc id is `${customerId}_${orderId}` (reviews.ts's reviewRef). The
    // client creates it directly (no Cloud Function does), so it must set
    // customerId itself for the ownership check below to work.
    match /reviews/{reviewId} {
      allow read: if isPrivileged() || isOwnUser(resource.data.customerId);
      allow create: if isOwnUser(request.resource.data.customerId);
      allow update, delete: if isPrivileged();
    }

    // Not yet touched by any Cloud Function (a client-direct feature, same as
    // it was in RTDB) - flattened here with denormalized owner-identifying
    // fields instead of the old {customerId}/{orderId}/{channel} nesting,
    // consistent with every other collection this migration flattened. Every
    // writer (customer, restaurant, rider) sets all three id fields on every
    // message, not just its own, so any participant can read the whole
    // thread regardless of who sent a given message.
    // Doc id: `${orderId}_${channel}_${messageId}`.
    match /orderChats/{messageId} {
      // A read checks the EXISTING document (resource.data); a create checks
      // the INCOMING one (request.resource.data) - request.resource is only
      // defined for writes, so using it in the read branch would error here.
      allow read: if isPrivileged()
        || isOwnUser(resource.data.customerId)
        || (isApprovedRider() && resource.data.riderId == request.auth.uid)
        || canManageRestaurant(resource.data.restaurantId, 'orders');
      allow create: if isPrivileged()
        || isOwnUser(request.resource.data.customerId)
        || (isApprovedRider() && request.resource.data.riderId == request.auth.uid)
        || canManageRestaurant(request.resource.data.restaurantId, 'orders');
      allow update, delete: if isPrivileged();
    }

    // ---------------------------------------------------------------
    // Riders
    // ---------------------------------------------------------------
    match /riders/{uid} {
      allow read: if isPrivileged() || isOwnUser(uid);
      // Only the face-check Cloud Function (Admin SDK, bypasses rules) may
      // create this document - see submitRiderFaceCheck in
      // functions/src/services/mediaUploads.ts. That keeps the very first
      // write always stamped with a real faceMatchStatus, so the rider's own
      // update below always has something genuine to check against instead
      // of a value the rider could have set themselves.
      allow create: if isPrivileged();
      // A rider may only submit their own application once a prior face
      // check already marked this document faceMatchStatus == 'unique', and
      // may not rewrite that verdict (or the indexed face id) while doing so
      // - closing the one path that would otherwise let a duplicate account
      // skip the check entirely by writing straight to Firestore.
      // A rider can always change their map avatar (and nothing else) with
      // this path - one of the fixed presets the apps know how to draw.
      allow update: if isOwnUser(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatar', 'avatarUpdatedAt'])
        && request.resource.data.avatar in ['bloom', 'lilac', 'mint', 'classic', 'midnight', 'forest', 'blue']
        && request.resource.data.avatarUpdatedAt is int;
      allow update: if isPrivileged() || (
        isOwnUser(uid)
        && request.resource.data.status == 'submitted'
        && resource.data.faceMatchStatus == 'unique'
        && request.resource.data.faceMatchStatus == resource.data.faceMatchStatus
        && request.resource.data.rekognitionFaceId == resource.data.rekognitionFaceId
        // Tax and compliance fields are set by the server / restricted
        // controls only (contractor vs employee lives in riderTaxClassifications).
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['taxClassification',
          'legalEntityType', 'panEntityType', 'panVerified', 'riderGstRegistered', 'riderGstin', 'riderRegistrationLiable',
          // Identity results are written only by the verification functions.
          'identity', 'aadhaarLast4', 'identityConsentVersion', 'identityConsentAt'])
        // Who referred a rider can be set once and never switched later (the
        // referral itself is frozen server-side in riderReferrals/{uid}).
        && (!('referredByCode' in resource.data)
          || request.resource.data.get('referredByCode', null) == resource.data.referredByCode)
      );
      allow delete: if isPrivileged();
    }

    // Gig-worker register for the Shram Suvidha portal (Social Security
    // (Central) Rules 2026, Rule 48): kept by gigRegistrySync, read and
    // marked "reported" by admins only.
    match /gigRegistry/{uid} {
      allow read: if isPrivileged();
      allow update: if isPrivileged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinReportedAt', 'exitReportedAt', 'eShramUan']);
      allow create, delete: if false;
    }

    match /riderDocuments/{uid} {
      allow read, write: if isPrivileged() || isOwnUser(uid);
    }

    // Still RTDB-authoritative (native apps write raw GPS presence directly
    // there; Phase 3 client work has not migrated that write path yet). Rules
    // kept here as an inert placeholder for whenever it does.
    match /riderPresence/{riderId} {
      allow read: if isPrivileged() || isOwnUser(riderId);
      allow write: if isPrivileged() || isOwnUser(riderId);
    }

    // Same as riderPresence - still RTDB-authoritative today.
    match /tracking/{orderId} {
      allow read: if isPrivileged()
        || isOwnUser(get(/databases/$(database)/documents/orders/$(orderId)).data.customerId)
        || (isApprovedRider() && resource.data.riderId == request.auth.uid)
        || canManageRestaurant(get(/databases/$(database)/documents/orders/$(orderId)).data.restaurantId, 'tracking');
      allow write: if isPrivileged() ||
        (isApprovedRider() && request.resource.data.riderId == request.auth.uid);
    }

    match /riderWallets/{riderId} {
      allow read: if isPrivileged() || isOwnUser(riderId);
      allow write: if isPrivileged(); // Server-owned COD ledger balance.
    }

    // Flat, auto-id docs with a riderId field - same shape the rider app
    // already wrote in RTDB (partnerSupport/{riderId}/{ticketId}), just
    // without the nesting.
    match /partnerSupport/{ticketId} {
      allow read: if isPrivileged() || isOwnUser(resource.data.riderId);
      allow create: if isOwnUser(request.resource.data.riderId);
      allow update, delete: if isPrivileged();
    }

    // ---------------------------------------------------------------
    // Customer-facing content
    // ---------------------------------------------------------------
    // Offers are written only through the upsertPromotionPolicy /
    // saveRestaurantOffer callables, which validate funding, run the
    // profitability simulation and audit every change. Budget counters
    // (usedBudgetPaise) are server-maintained inside the order transaction,
    // so no client - admin included - may write this collection directly.
    match /promotions/{promoId} {
      allow read: if true;
      allow write: if false;
    }

    match /localAds/{adId} {
      allow read: if true;
      allow write: if isPrivileged();
    }

    match /customerBroadcasts/{id} {
      allow read: if signedIn();
      allow write: if isPrivileged();
    }

    // Live weather per store (Google Weather, refreshed every 15 minutes):
    // rain, its fee and the condition. Public, like the store listing.
    match /pricingSignals/{restaurantId} {
      allow read: if true;
      allow write: if false;
    }

    // Dine-in (Phase 1). Every write goes through the dine-in callables, so the
    // apps only read: a customer their own bookings and the tables they sit at,
    // restaurant staff their own restaurant's bookings and tables.
    match /dineBookings/{bookingId} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid
        || isPrivileged() || canManageRestaurant(resource.data.restaurantId, 'orders'));
      allow write: if false;
    }
    match /tableSessions/{sessionId} {
      allow read: if signedIn() && (request.auth.uid in resource.data.get('memberUids', [])
        || isPrivileged() || canManageRestaurant(resource.data.restaurantId, 'orders'));
      allow write: if false;
      match /rounds/{roundId} {
        allow read: if signedIn() && (request.auth.uid in get(/databases/$(database)/documents/tableSessions/$(sessionId)).data.get('memberUids', [])
          || isPrivileged() || canManageRestaurant(get(/databases/$(database)/documents/tableSessions/$(sessionId)).data.restaurantId, 'orders'));
        allow write: if false;
      }
    }

    // Squad orders: a host opens a squad at one restaurant and shares its
    // 6-character code; friends who have the code put their picks in (one
    // document each). The host locks it and checks out the combined cart as a
    // normal order, which the server prices as usual. The code is the invite,
    // so squads can be fetched one by one but never listed.
    match /squads/{code} {
      function squadOpen() {
        return get(/databases/$(database)/documents/squads/$(code)).data.status == 'open'
          && get(/databases/$(database)/documents/squads/$(code)).data.expiresAt > request.time.toMillis();
      }
      allow get: if signedIn() && code.matches('^[A-Z0-9]{6}$');
      allow list: if false;
      allow create: if signedIn() && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly(['hostUid', 'hostName', 'restaurantId', 'restaurantName', 'status', 'createdAt', 'expiresAt', 'orderId'])
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.restaurantId is string && request.resource.data.restaurantId.size() <= 128
        && request.resource.data.restaurantName is string && request.resource.data.restaurantName.size() <= 120
        && request.resource.data.hostName is string && request.resource.data.hostName.size() <= 60
        && request.resource.data.expiresAt is int
        && request.resource.data.expiresAt <= request.time.toMillis() + 4 * 60 * 60 * 1000;
      allow update: if signedIn() && resource.data.hostUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'orderId'])
        && request.resource.data.status in ['open', 'locked', 'ordered', 'closed'];
      allow delete: if false;

      match /picks/{uid} {
        allow read: if signedIn() && code.matches('^[A-Z0-9]{6}$');
        allow create, update: if isOwnUser(uid) && squadOpen()
          && request.resource.data.keys().hasOnly(['name', 'items', 'subtotal', 'updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && request.resource.data.items is list && request.resource.data.items.size() <= 30
          && request.resource.data.subtotal is number;
        allow delete: if isOwnUser(uid) && squadOpen();
      }
    }

    match /settings/{doc} {
      // Pricing config the client needs to render fee previews. voiceAgent holds test phone numbers: staff only.
      allow read: if doc != "voiceAgent" || isPrivileged();
      allow write: if isPrivileged();
    }

    // Friends & chat. Profiles, codes, friend requests, reports and parent
    // approvals change only through Cloud Functions. Messages are written by
    // the app, but only between accepted friends, by an account allowed to
    // chat (not suspended or banned; a minor only after a parent approves).
    // Date of birth and parent approval for the whole account: set only
    // through Cloud Functions, so changes are logged and parents are told.
    match /accountAges/{uid} {
      allow read: if isOwnUser(uid) || isPrivileged();
      allow write: if false;
    }
    match /chatProfiles/{uid} {
      allow read: if isOwnUser(uid) || isPrivileged();
      allow write: if false;
    }
    match /friendCodes/{code} {
      allow read, write: if false;
    }
    match /usernames/{username} {
      allow read, write: if false;
    }
    // Profile photos: a small square JPEG the person sets themselves. Only they,
    // their friends and people with a pending request with them can see it.
    match /chatAvatars/{uid} {
      function pairId() {
        return request.auth.uid < uid ? request.auth.uid + "_" + uid : uid + "_" + request.auth.uid;
      }
      allow read: if request.auth != null && (request.auth.uid == uid || isPrivileged()
        || (exists(/databases/$(database)/documents/friendships/$(pairId()))
            && get(/databases/$(database)/documents/friendships/$(pairId())).data.status != "blocked"));
      allow create, update: if isOwnUser(uid)
        && request.resource.data.keys().hasOnly(["image", "updatedAt"])
        && request.resource.data.image is string
        && request.resource.data.image.size() < 90000
        && request.resource.data.image.matches("^data:image/jpeg;base64,.*")
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwnUser(uid) || isPrivileged();
    }
    match /friendships/{pairId} {
      allow read: if request.auth != null && (request.auth.uid in resource.data.members || isPrivileged());
      allow write: if false;
    }
    match /parentRequests/{childUid} {
      allow read: if request.auth != null && (request.auth.uid == childUid || request.auth.uid == resource.data.parentUid || isPrivileged());
      allow write: if false;
    }
    // Ask a parent to pay: the child and the parent can read; only the server writes.
    match /parentPayRequests/{requestId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.childUid || request.auth.uid == resource.data.parentUid || isPrivileged());
      allow write: if false;
    }
    match /chatReports/{reportId} {
      allow read: if isPrivileged();
      allow write: if false;
    }
    match /chats/{pairId}/messages/{messageId} {
      function pair() { return get(/databases/$(database)/documents/friendships/$(pairId)).data; }
      function me() { return get(/databases/$(database)/documents/chatProfiles/$(request.auth.uid)).data; }
      function mayChat() {
        return (me().status == "active" || (me().status == "suspended" && me().suspendedUntil < request.time.toMillis()))
          && (me().minor != true || me().parentStatus == "approved");
      }
      allow read: if request.auth != null && (isPrivileged() || request.auth.uid in pair().members);
      allow create: if request.auth != null
        && request.auth.uid in pair().members && pair().status == "accepted" && mayChat()
        && request.resource.data.keys().hasOnly(["from", "text", "card", "at"])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000
        && (request.resource.data.text.size() > 0 || request.resource.data.card is map)
        && (!("card" in request.resource.data) || (request.resource.data.card is map && request.resource.data.card.size() <= 10));
      // A reaction: a member sets or clears only their own emoji, nothing else.
      allow update: if request.auth != null
        && request.auth.uid in pair().members && pair().status == "accepted"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reactions"])
        && request.resource.data.reactions is map
        && request.resource.data.reactions.diff(resource.data.get("reactions", {})).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.reactions)
            || request.resource.data.reactions[request.auth.uid] in ["❤️", "😂", "😮", "😢", "🔥", "👍", "🌶️", "🍦", "🤤"]);
      // Delete for me: a member hides a message from their own view only (unsend goes through the server).
      allow update: if request.auth != null
        && request.auth.uid in pair().members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["hiddenFor"])
        && request.resource.data.hiddenFor is map
        && request.resource.data.hiddenFor.diff(resource.data.get("hiddenFor", {})).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.hiddenFor[request.auth.uid] == true;
      allow delete: if false;
    }
    // A photo sent in a chat: its own document, pointed to by a message card. Only the
    // two friends read it (not once a report removes it); it can't be changed later.
    match /chats/{pairId}/photos/{photoId} {
      function photoPair() { return get(/databases/$(database)/documents/friendships/$(pairId)).data; }
      function photoMe() { return get(/databases/$(database)/documents/chatProfiles/$(request.auth.uid)).data; }
      allow read: if request.auth != null && (isPrivileged()
        || (request.auth.uid in photoPair().members && resource.data.get("removed", false) != true));
      allow create: if request.auth != null
        && request.auth.uid in photoPair().members && photoPair().status == "accepted"
        && (photoMe().status == "active" || (photoMe().status == "suspended" && photoMe().suspendedUntil < request.time.toMillis()))
        && (photoMe().minor != true || photoMe().parentStatus == "approved")
        && request.resource.data.keys().hasOnly(["from", "image", "w", "h", "at"])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.image is string && request.resource.data.image.size() <= 720000
        && request.resource.data.image.matches("data:image/jpeg;base64,[A-Za-z0-9+/=]+")
        && request.resource.data.w is int && request.resource.data.w > 0 && request.resource.data.w <= 4096
        && request.resource.data.h is int && request.resource.data.h > 0 && request.resource.data.h <= 4096;
      allow update, delete: if false;
    }
    // A voice message: like a photo, its own document pointed to by a message card. Opus audio
    // up to 2 minutes (about 450 KB as text); only the two friends hear it, and it can't be changed.
    match /chats/{pairId}/voices/{voiceId} {
      function voicePair() { return get(/databases/$(database)/documents/friendships/$(pairId)).data; }
      function voiceMe() { return get(/databases/$(database)/documents/chatProfiles/$(request.auth.uid)).data; }
      allow read: if request.auth != null && (isPrivileged()
        || (request.auth.uid in voicePair().members && resource.data.get("removed", false) != true));
      allow create: if request.auth != null
        && request.auth.uid in voicePair().members && voicePair().status == "accepted"
        && (voiceMe().status == "active" || (voiceMe().status == "suspended" && voiceMe().suspendedUntil < request.time.toMillis()))
        && (voiceMe().minor != true || voiceMe().parentStatus == "approved")
        && request.resource.data.keys().hasOnly(["from", "audio", "ms", "at"])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.audio is string && request.resource.data.audio.size() <= 650000
        && request.resource.data.audio.matches("data:audio/(webm|ogg|mp4|aac)(;codecs=opus)?;base64,[A-Za-z0-9+/=]+")
        && request.resource.data.ms is int && request.resource.data.ms > 0 && request.resource.data.ms <= 120500;
      allow update, delete: if false;
    }

    // Voice and video calls between friends. The call document carries the WebRTC offer/answer
    // and the status; each side adds its own network candidates. No audio or video is stored.
    match /calls/{callId} {
      function callPair(pid) { return get(/databases/$(database)/documents/friendships/$(pid)).data; }
      function callMe() { return get(/databases/$(database)/documents/chatProfiles/$(request.auth.uid)).data; }
      function inCall() { return request.auth != null && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to); }
      allow read: if inCall();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(["from", "to", "pairId", "kind", "status", "offer", "createdAt"])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && callPair(request.resource.data.pairId).status == "accepted"
        && request.auth.uid in callPair(request.resource.data.pairId).members
        && request.resource.data.to in callPair(request.resource.data.pairId).members
        && (callMe().status == "active" || (callMe().status == "suspended" && callMe().suspendedUntil < request.time.toMillis()))
        && (callMe().minor != true || callMe().parentStatus == "approved")
        && request.resource.data.kind in ["audio", "video"]
        && request.resource.data.status == "ringing"
        && request.resource.data.createdAt == request.time
        && request.resource.data.offer is map && request.resource.data.offer.keys().hasOnly(["type", "sdp"])
        && request.resource.data.offer.sdp is string && request.resource.data.offer.sdp.size() <= 20000;
      // Who, what and when the call started never change. The person called answers (or declines);
      // either side ends it; the caller can give up while it rings.
      allow update: if inCall()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "answer", "answeredAt", "endedAt", "endedBy", "ringingAt"])
        // The person called marks it ringing once their phone shows it (the caller sees "Ringing…").
        && (!("ringingAt" in request.resource.data.diff(resource.data).affectedKeys()) || (request.auth.uid == resource.data.to
              && resource.data.status == "ringing" && request.resource.data.ringingAt == request.time))
        && request.resource.data.status in ["ringing", "accepted", "declined", "busy", "missed", "cancelled", "ended"]
        && !(resource.data.status in ["declined", "busy", "missed", "cancelled", "ended"])
        && (!("answer" in request.resource.data.diff(resource.data).affectedKeys()) || (request.auth.uid == resource.data.to
              && request.resource.data.answer is map && request.resource.data.answer.keys().hasOnly(["type", "sdp"])
              && request.resource.data.answer.sdp is string && request.resource.data.answer.sdp.size() <= 20000))
        && (request.resource.data.status != "accepted" || request.auth.uid == resource.data.to)
        && (!(request.resource.data.status in ["declined", "busy"]) || request.auth.uid == resource.data.to)
        && (!(request.resource.data.status in ["missed", "cancelled"]) || request.auth.uid == resource.data.from);
      allow delete: if false;
      match /candidates/{candidateId} {
        function theCall() { return get(/databases/$(database)/documents/calls/$(callId)).data; }
        allow read: if request.auth != null && (request.auth.uid == theCall().from || request.auth.uid == theCall().to);
        allow create: if request.auth != null && (request.auth.uid == theCall().from || request.auth.uid == theCall().to)
          && request.resource.data.keys().hasOnly(["by", "c"])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.c is map && request.resource.data.c.size() <= 4;
        allow update, delete: if false;
      }
    }

    // Friends' feed: food photos and 24-hour stories, seen only by the poster's friends.
    // The server copies each new post's card into the feed of the poster and each friend;
    // a friend reads a post and its photo only while that card is in their own feed.
    function inMyFeed(postId) {
      return exists(/databases/$(database)/documents/feeds/$(request.auth.uid)/feedItems/$(postId));
    }
    function mayShare() {
      let me = get(/databases/$(database)/documents/chatProfiles/$(request.auth.uid)).data;
      return (me.status == "active" || (me.status == "suspended" && me.suspendedUntil < request.time.toMillis()))
        && (me.get("minor", false) != true || me.get("parentStatus", "") == "approved");
    }
    match /feeds/{uid}/feedItems/{postId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /posts/{postId} {
      allow read: if request.auth != null && (isPrivileged() || resource.data.from == request.auth.uid || inMyFeed(postId));
      // A story may also go to Close Friends only ("to"), be a video (its clip in Storage,
      // "dur" in ms) and carry interactive stickers (cleaned by the server).
      allow create: if request.auth != null && mayShare()
        && request.resource.data.keys().hasOnly(["from", "kind", "caption", "w", "h", "createdAt", "to", "video", "dur", "stickers"])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.kind in ["story", "post"]
        && request.resource.data.get("to", "friends") in ["friends", "close"]
        && (!("video" in request.resource.data) || (request.resource.data.video == true && request.resource.data.kind == "story"
          && request.resource.data.dur is int && request.resource.data.dur >= 500 && request.resource.data.dur <= 16000))
        && (!("stickers" in request.resource.data) || (request.resource.data.stickers is list && request.resource.data.stickers.size() <= 6))
        && request.resource.data.caption is string && request.resource.data.caption.size() <= 200
        && request.resource.data.w is int && request.resource.data.w > 0 && request.resource.data.w <= 4096
        && request.resource.data.h is int && request.resource.data.h > 0 && request.resource.data.h <= 4096
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/postMedia/$(postId))
        && get(/databases/$(database)/documents/postMedia/$(postId)).data.from == request.auth.uid;
      // A friend likes (true, or a reaction emoji on a story) or views: only their own entry in "likes" / "views", nothing else.
      allow update: if request.auth != null && resource.data.from != request.auth.uid && inMyFeed(postId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likes", "views"])
        && request.resource.data.get("likes", {}).diff(resource.data.get("likes", {})).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.get("views", {}).diff(resource.data.get("views", {})).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.get("likes", {})) || request.resource.data.likes[request.auth.uid] == true
          || request.resource.data.likes[request.auth.uid] in ["😋", "🤤", "🔥", "😍", "😂", "👏"])
        && (!(request.auth.uid in request.resource.data.get("views", {})) || request.resource.data.views[request.auth.uid] is int);
      // The poster edits a caption, changes a story's audience, or keeps a story in a highlight.
      allow update: if request.auth != null && resource.data.from == request.auth.uid && mayShare()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["caption", "to", "hl"])
        && request.resource.data.caption is string && request.resource.data.caption.size() <= 200
        && request.resource.data.get("to", "friends") in ["friends", "close"]
        && (resource.data.kind == "story" || request.resource.data.get("to", "friends") == resource.data.get("to", "friends"))
        && request.resource.data.get("hl", false) is bool;
      allow delete: if request.auth != null && resource.data.from == request.auth.uid;
    }
    // Answers to a story's stickers: one record per friend (poll choice, slider value,
    // question answer, keyed by the sticker's place). The poster reads them all; the server
    // totals them on the story for everyone.
    match /posts/{postId}/responses/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isPrivileged()
        || get(/databases/$(database)/documents/posts/$(postId)).data.from == request.auth.uid);
      allow create, update: if request.auth != null && request.auth.uid == uid && mayShare() && inMyFeed(postId)
        && get(/databases/$(database)/documents/posts/$(postId)).data.from != request.auth.uid
        && request.resource.data.keys().hasOnly(["from", "poll", "slider", "ask", "at"])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.get("poll", {}) is map && request.resource.data.get("poll", {}).size() <= 6
        && request.resource.data.get("slider", {}) is map && request.resource.data.get("slider", {}).size() <= 6
        && request.resource.data.get("ask", {}) is map && request.resource.data.get("ask", {}).size() <= 6;
      allow delete: if false;
    }
    // Who sees your stories: a Close Friends list and people your stories are hidden from.
    match /storyPrefs/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["close", "hide", "updatedAt"])
        && request.resource.data.get("close", []) is list && request.resource.data.get("close", []).size() <= 500
        && request.resource.data.get("hide", []) is list && request.resource.data.get("hide", []).size() <= 500
        && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Story highlights on a profile: the owner's named sets of kept stories. Friends may read
    // them; each story inside still needs its own card in their feed to open.
    function friendsWith(other) {
      let pid = request.auth.uid < other ? request.auth.uid + "_" + other : other + "_" + request.auth.uid;
      return exists(/databases/$(database)/documents/friendships/$(pid))
        && get(/databases/$(database)/documents/friendships/$(pid)).data.status == "accepted";
    }
    match /highlights/{id} {
      allow read: if request.auth != null && (resource.data.from == request.auth.uid || isPrivileged() || friendsWith(resource.data.from));
      allow create, update: if request.auth != null && request.resource.data.from == request.auth.uid && mayShare()
        && (resource == null || resource.data.from == request.auth.uid)
        && request.resource.data.keys().hasOnly(["from", "title", "items", "cover", "updatedAt"])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 30
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 100
        && request.resource.data.cover is string && request.resource.data.cover.size() <= 128
        && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null && resource.data.from == request.auth.uid;
    }
    // Comments on a post or story: seen by everyone the post is shown to. The app writes
    // who and what; the server adds the commenter's name. The commenter or the poster can remove one.
    match /posts/{postId}/comments/{commentId} {
      allow read: if request.auth != null && (isPrivileged() || inMyFeed(postId));
      allow create: if request.auth != null && mayShare() && inMyFeed(postId)
        && request.resource.data.keys().hasOnly(["from", "text", "at"])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
        && request.resource.data.at == request.time;
      allow delete: if request.auth != null && (resource.data.from == request.auth.uid
        || get(/databases/$(database)/documents/posts/$(postId)).data.from == request.auth.uid);
      allow update: if false;
    }
    match /postMedia/{postId} {
      allow read: if request.auth != null && (isPrivileged()
        || (resource.data.get("removed", false) != true && (resource.data.from == request.auth.uid || inMyFeed(postId))));
      allow create: if request.auth != null && mayShare()
        && request.resource.data.keys().hasOnly(["from", "image", "at"])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.image is string && request.resource.data.image.size() <= 720000
        && request.resource.data.image.matches("data:image/jpeg;base64,[A-Za-z0-9+/=]+");
      allow update: if false;
      allow delete: if request.auth != null && resource.data.from == request.auth.uid && resource.data.get("removed", false) != true;
    }

    // Daily meal plans: anyone signed in can browse plans; changes go through
    // Cloud Functions. Customers read only their own subscriptions.
    match /mealPlans/{planId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /mealSubscriptions/{subscriptionId} {
      allow read: if isPrivileged() || isOwnUser(resource.data.customerId);
      allow write: if false;
    }

    match /support/{ticketId} {
      allow read: if isPrivileged() || isOwnUser(resource.data.uid);
      allow create: if isOwnUser(request.resource.data.uid);
      allow update: if isPrivileged();
      allow delete: if isPrivileged();
    }

    // Consent to the privacy notice (DPDP Act, 2023, s.6), one record per
    // account and kind of app: {uid}_{customer|store|rider}. Only the person
    // themselves can give it, only for themselves, and only with the fields
    // the apps send; admins can read it as proof of consent.
    match /privacyConsents/{consentId} {
      allow read: if isPrivileged() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if isOwnUser(request.resource.data.uid)
        && consentId == request.resource.data.uid + '_' + request.resource.data.audience
        && request.resource.data.audience in ['customer', 'store', 'rider']
        && request.resource.data.keys().hasOnly(['uid', 'audience', 'version', 'lang', 'method', 'app', 'acceptedAt', 'history'])
        && request.resource.data.version is string && request.resource.data.version.size() <= 20
        && request.resource.data.lang in ['en', 'te']
        && request.resource.data.method in ['signup', 'gate']
        && request.resource.data.acceptedAt is int;
      allow delete: if isPrivileged();
    }

    match /privacyRequests/{requestId} {
      allow read: if isPrivileged() || isOwnUser(resource.data.uid);
      allow create: if isOwnUser(request.resource.data.uid);
      allow update, delete: if isPrivileged();
    }

    // ---------------------------------------------------------------
    // Admin-only / server-only collections (Cloud Functions' Admin SDK
    // bypasses these rules entirely; this just denies direct client access,
    // matching RTDB's 'private/*' owner/ops_admin-only gate).
    // ---------------------------------------------------------------
    match /private/{document=**} {
      allow read: if isPrivileged();
      allow write: if false;
    }

    match /audit/{eventId} {
      allow read: if isPrivileged();
      allow write: if false;
    }

    match /notifications/{uid} {
      allow read: if isPrivileged() || isOwnUser(uid);
      allow write: if false;
    }

    match /admin/{document=**} {
      allow read, write: if isPrivileged();
    }

    match /restaurantLoad/{restaurantId} {
      allow read: if isPrivileged() || canManageRestaurant(restaurantId, 'orders');
      allow write: if false; // Server-computed only.
    }

    // Economics engine records are server-only and reached through admin
    // callables: economicsControl, economicsControlHistory, orderEconomics
    // (Scraveit's per-order margin and reserves), promotionRedemptions,
    // promotionCustomerUsage, growthBudgets, riderGuaranteeSettlements,
    // riderGuaranteeBudgets and riderGuaranteeEnrollments all fall through to
    // the deny-all below on purpose. So do the wallet and reward records
    // (customerWallets, walletLots, walletEntries, cashbackCampaigns,
    // cashbackCustomerUsage, walletDailyEarn, customerReferral*,
    // referralInstallations, riderReferrals (and their countedOrders),
    // riderReferralProgrammeVersions, riderReferralAwards,
    // riderReferralInviterCounts, programBudgets) and city finance
    // (cityOperatingCosts): customers read their own wallet only through the
    // getCustomerWallet callable, and riders see their referrals only through
    // getRiderRewardsDashboard.
    //
    // Everything else server-owned with no client read path at all today
    // (backendEvents, orderIdempotency, platformConfig, pricingSignals,
    // riderAvailability, deviceTokens, catalogSearchTokens excluded above,
    // riderRestaurantArrivals, riderKycObjects, uploadQuotas,
    // mediaUploadLocks, restaurantSettlements*, riderPayouts*, and every
    // other 'private/*' collection's own name) falls through to the deny-all
    // catch-all below - the Firestore equivalent of RTDB's root-level
    // '$other': { '.validate': false }.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
