rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && (
        request.auth.token.savrivoRole == 'owner' ||
        request.auth.token.savrivoRole == 'ops_admin'
      );
    }

    // Public food/restaurant media. Writers are scoped by their authenticated UID
    // in the object path; RTDB rules separately decide which restaurant/menu URL
    // that UID is allowed to publish.
    match /restaurants/{restaurantId}/users/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if signedIn() && (request.auth.uid == uid || admin());
    }

    match /admin-uploads/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if admin() && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if admin();
    }

    // Rider identity documents are private. Only the rider and trusted Savrivo
    // administrators can read them.
    match /rider-kyc/{uid}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
