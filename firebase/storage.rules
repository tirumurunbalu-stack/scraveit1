rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && (
        request.auth.token.savrivoRole == 'owner' ||
        request.auth.token.savrivoRole == 'ops_admin'
      );
    }

    // Public food/restaurant media. Writers are scoped by their authenticated UID
    // in the object path; RTDB rules separately decide which restaurant/menu URL
    // that UID is allowed to publish.
    match /restaurants/{restaurantId}/users/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if signedIn() && (request.auth.uid == uid || admin());
    }

    match /admin-uploads/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if admin() && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if admin();
    }

    // Rider identity documents and face-verification reference photos are
    // private. Only the rider and trusted Savrivo administrators can read
    // them directly; the Admin app's photo review instead relies on a
    // Firebase download token stamped onto each object at upload time
    // (bypasses these rules by design), so this only governs authenticated
    // SDK access - e.g. a rider viewing their own file.
    match /private/rider-kyc/{uid}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /private/rider-face/{uid}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Restaurant sign-up documents (FSSAI, PAN, bank proof, menu card):
    // only the applicant and Scraveit admins. Admin review uses short-lived
    // signed links from Cloud Functions.
    match /private/restaurant-onboarding/{uid}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Sealed-packet photos, taken by restaurant staff before handover. Only
    // the uploader writes (once); customers see them through a signed link
    // that Cloud Functions puts on the order after checking the order.
    match /private/packed-orders/{restaurantId}/{uid}/{fileName} {
      allow read: if admin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg');
    }

    // The rider's photo of the parcel (order ID showing) taken at pickup. Only
    // the rider writes it, once; the server checks it before the order is
    // handed over and keeps a signed link on the order for support.
    match /private/rider-pickups/{uid}/{fileName} {
      allow read: if admin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg');
    }

    // A customer's photo of their gate or building, so the rider can spot the
    // place. Only the customer writes and reads it here; the rider opens it
    // through the download link that goes on the order with the address (the
    // server only copies links that point into the customer's own folder).
    match /addressPhotos/{uid}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg');
      allow delete: if signedIn() && (request.auth.uid == uid || admin());
    }

    // Video stories: the poster uploads the clip before posting; a friend may play it
    // while the story's card is in their feed (the same test as the story's photo).
    match /storyVideos/{uid}/{postId} {
      allow read: if signedIn() && (request.auth.uid == uid || admin()
        || firestore.exists(/databases/(default)/documents/feeds/$(request.auth.uid)/feedItems/$(postId)));
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('video/(mp4|webm)');
      allow delete: if signedIn() && (request.auth.uid == uid || admin());
    }

    // Public reels: the poster uploads the clip (up to 60 s, under 25 MB) and its first-frame picture
    // before calling createReel. Viewers play them through the download link the server puts on a
    // live reel; removing a reel deletes the files, so the link stops working.
    match /reelVideos/{uid}/{reelId} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('video/(mp4|webm)')
        && !firestore.exists(/databases/(default)/documents/reels/$(reelId));
      allow delete: if signedIn() && (request.auth.uid == uid || admin());
    }
    match /reelThumbs/{uid}/{reelId} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.size < 400 * 1024
        && request.resource.contentType.matches('image/jpeg')
        && !firestore.exists(/databases/(default)/documents/reels/$(reelId));
      allow delete: if signedIn() && (request.auth.uid == uid || admin());
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
